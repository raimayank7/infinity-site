{
 "name": "Infinity by GroupChatOn",
 "short_name": "Infinity",
 "id": "/",
 "description": "609 free tools that run on your device: PDF, image, video, text, developer tools, calculators, invoices and a money manager. Works offline.",
 "start_url": "/?source=pwa",
 "scope": "/",
 "display": "standalone",
 "display_override": [
  "standalone",
  "minimal-ui"
 ],
 "launch_handler": {
  "client_mode": "focus-existing"
 },
 "orientation": "any",
 "background_color": "#05060F",
 "theme_color": "#05060F",
 "lang": "en",
 "dir": "ltr",
 "categories": [
  "utilities",
  "productivity",
  "business"
 ],
